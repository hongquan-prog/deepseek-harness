{
  "name": "@deepseek-ai/dsh-wsl-bundle",
  "description": "The dsh WSL bundle: filesystem, process and sandbox providers running in one WSL distribution",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/wsl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-loader-smoke": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-ssh": "workspace:*",
    "@deepseek-ai/dsh-sandbox-ssh": "workspace:*",
    "@deepseek-ai/dsh-subprocess-ssh": "workspace:*",
    "@deepseek-ai/dsh-wsl": "workspace:*",
    "@deepseek-ai/dsh-host-directory-picker-wsl": "workspace:*",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "workspace:*"
  }
}
